# Copie este arquivo para .env e ajuste. SECRET_KEY é OBRIGATÓRIA
# (a aplicação se recusa a iniciar sem ela).

SECRET_KEY=change-this-secret-key

# Banco de dados. Por padrão o app usa SQLite (app/blog.db) — deixe
# DATABASE_URL comentada para começar. Descomente apenas se for usar
# PostgreSQL/Supabase:
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Upload de imagens (OPCIONAL — só necessário para enviar imagens ao
# Supabase Storage). Descomente se for usar:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# SUPABASE_BUCKET=post-images
# SUPABASE_PUBLIC_URL_BASE=https://your-project.supabase.co

# Número de tentativas/espera no upload (defaults)
# UPLOAD_RETRIES=5
# UPLOAD_BACKOFF_SECONDS=2

# Sessão: ative em produção (HTTPS)
# SESSION_COOKIE_SECURE=true

# Hosts permitidos (validação anti Host-header injection)
# TRUSTED_HOSTS=seu-dominio.com,localhost,127.0.0.1

# Debug do run.py (nunca em produção)
# FLASK_DEBUG=0
